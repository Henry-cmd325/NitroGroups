@page "/"

@using NitroGroups.UI.Blazor.Shared.Components.Controls
@using static NitroGroups.UI.Blazor.Shared.Components.Controls.Badge

<section class="relative overflow-hidden bg-gradient-to-b from-muted/20 to-background">
    <div class="container mx-auto px-4 py-15 lg:py-18">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            
            <div class="space-y-8">
                <div class="space-y-4">

                    <Badge Variant="BadgeVariant.Secondary" Class="w-fit">
                        &#127925; Conecta la música con el mundo
                    </Badge>
                    
                    <h1 class="text-4xl lg:text-6xl font-bold tracking-tight">
                        La plataforma que conecta
                        <span class="text-primary">artistas</span> con
                        <span class="text-primary">eventos</span>
                    </h1>
                    <p class="text-xl text-muted-foreground max-w-lg">
                        NitroGroups es el punto de encuentro entre grupos musicales independientes 
                        y organizadores de eventos. Gestiona tu agenda, conecta con clientes y 
                        haz crecer tu carrera musical.
                    </p>
                </div>

                <div class="flex flex-col sm:flex-row gap-4">
                    
                    <button class="cursor-pointer text-lg h-12 px-8 rounded bg-primary text-white hover:bg-primary/90">
                        <div class="flex items-center">
                            <Icon class="h-6 mr-2">
                                <PlayIcon />
                            </Icon>
                            <span>Comenzar Ahora</span>
                        </div>
                    </button>
                </div>

                <div class="flex items-center space-x-8 pt-4">
                    
                    <div class="flex items-center space-x-2">
                        <Icon class="text-muted-foreground h-6">
                            <CrowdIcon/>
                        </Icon>
                        <span class="text-sm text-muted-foreground">500+ Artistas</span>
                    </div>
                    
                    <div class="flex items-center space-x-2">
                        <Icon class="text-muted-foreground h-6">
                            <CalendarIcon/>
                        </Icon>
                        <span class="text-sm text-muted-foreground">1000+ Eventos</span>
                    </div>
                </div>
            </div>

            <div class="relative">
                <div class="relative rounded-2xl overflow-hidden shadow-2xl">
                    <img
                        src="https://images.unsplash.com/photo-1544598256-fc4016e12325?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxsaXZlJTIwbXVzaWMlMjBjb25jZXJ0JTIwYmFuZCUyMHN0YWdlfGVufDF8fHx8MTc1NzgyMTg3NHww&ixlib=rb-4.1.0&q=80&w=1080&utm_source=figma&utm_medium=referral"
                        alt="Concierto en vivo"
                        class="w-full h-[400px] lg:h-[500px] object-cover"
                        loading="lazy"
                    />
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <div class="absolute bottom-6 left-6 text-white">
                        <p class="text-lg font-semibold">&#127928; Conecta con tu audiencia</p>
                        <p class="text-sm opacity-90">Miles de eventos esperando por tu música</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Inject] private AuthenticationStateProvider authProvider { get; set; } = null!;
    [Inject] private NavigationManager NavManager { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await authProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavManager.NavigateTo("/dashboard/musician");
        }
    }
}