@page "/group-profile"
@using NitroGroups.Shared.Contracts.Groups

<div class="bg-gray-900 text-white min-h-screen p-8">
    <div class="max-w-7xl mx-auto">

        @if (isEditing)
        {
            <EditForm Model="@group" OnValidSubmit="HandleSave" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <DataAnnotationsValidator />

                {/* Left Column: Editable Form */}
                <div class="md:col-span-2 space-y-6">
                    <div class="flex items-center space-x-4">
                        <div class="w-24 h-24 bg-gray-700 rounded-full flex items-center justify-center">
                            <span class="text-gray-400">Image</span>
                        </div>
                        <div>
                            <label for="groupName" class="block text-sm font-medium text-gray-400">Group Name</label>
                            <InputText id="groupName" class="mt-1 block w-full bg-gray-800 border-gray-700 rounded-md shadow-sm py-2 px-3 text-white focus:outline-none focus:ring-violet-500 focus:border-violet-500 sm:text-sm" @bind-Value="group.GroupName" />
                        </div>
                    </div>

                    <div>
                        <label for="description" class="block text-sm font-medium text-gray-400">Description</label>
                        <InputTextArea id="description" class="mt-1 block w-full bg-gray-800 border-gray-700 rounded-md shadow-sm py-2 px-3 text-white focus:outline-none focus:ring-violet-500 focus:border-violet-500 sm:text-sm" @bind-Value="group.Description" rows="3" />
                    </div>

                    <div>
                        <label for="biography" class="block text-sm font-medium text-gray-400">Biography</label>
                        <InputTextArea id="biography" class="mt-1 block w-full bg-gray-800 border-gray-700 rounded-md shadow-sm py-2 px-3 text-white focus:outline-none focus:ring-violet-500 focus:border-violet-500 sm:text-sm" @bind-Value="group.Biography" rows="5" />
                    </div>
                </div>

                {/* Right Column: Editable Form */}
                <div class="bg-gray-800 p-6 rounded-lg space-y-6">
                    <h3 class="text-xl font-semibold text-white">Información de Contratación</h3>
                    <div>
                        <label for="basePrice" class="block text-sm font-medium text-gray-400">Rango de precio</label>
                        <InputNumber id="basePrice" class="mt-1 block w-full bg-gray-700 border-gray-600 rounded-md shadow-sm py-2 px-3 text-white focus:outline-none focus:ring-violet-500 focus:border-violet-500 sm:text-sm" @bind-Value="group.BasePrice" />
                    </div>
                    <div>
                        <label for="yearsExperience" class="block text-sm font-medium text-gray-400">Experiencia</label>
                        <InputNumber id="yearsExperience" class="mt-1 block w-full bg-gray-700 border-gray-600 rounded-md shadow-sm py-2 px-3 text-white focus:outline-none focus:ring-violet-500 focus:border-violet-500 sm:text-sm" @bind-Value="group.YearsExperience" />
                    </div>
                    <div class="space-y-4">
                        <button type="submit" class="w-full bg-violet-600 hover:bg-violet-700 text-white font-bold py-3 px-4 rounded-lg transition-colors">Save Changes</button>
                        <button type="button" class="w-full bg-gray-600 hover:bg-gray-700 text-white font-bold py-3 px-4 rounded-lg transition-colors" @onclick="HandleCancel">Cancel</button>
                    </div>
                </div>
            </EditForm>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {/* Left Column: Display */}
                <div class="md:col-span-2">
                    <div class="flex items-center space-x-6">
                        <img class="h-24 w-24 rounded-full object-cover" src="https://via.placeholder.com/150" alt="Band photo" />
                        <div>
                            <h1 class="text-4xl font-bold">@group.GroupName</h1>
                            <div class="flex items-center space-x-4 text-gray-400 mt-2">
                                <span>🎵 Rock Alternativo</span>
                                <span>📍 @group.LocationText</span>
                                <span>⭐ @group.AverageRating (@group.TotalReviews reseñas)</span>
                            </div>
                        </div>
                    </div>
                    <p class="mt-6 text-gray-300">@group.Description</p>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm">Rock</span>
                        <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm">Alternativo</span>
                        <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm">Pop Rock</span>
                        <span class="bg-gray-700 text-gray-300 px-3 py-1 rounded-full text-sm">Covers</span>
                    </div>
                </div>

                {/* Right Column: Display */}
                <div class="bg-gray-800 p-6 rounded-lg h-fit">
                    <h3 class="text-xl font-semibold text-white">Información de Contratación</h3>
                    <div class="mt-6 space-y-4">
                        <div>
                            <span class="text-gray-400 text-sm">Rango de precio</span>
                            <p class="text-violet-400 font-bold text-2xl">$@group.BasePrice-$@(@group.BasePrice + 700)</p>
                        </div>
                        <div>
                            <span class="text-gray-400 text-sm">Experiencia</span>
                            <p class="text-white font-semibold">@group.YearsExperience+ años</p>
                        </div>
                        <div>
                            <span class="text-gray-400 text-sm">Disponibilidad</span>
                            <p class="text-white font-semibold">Disponible fines de semana</p>
                        </div>
                    </div>
                    <button class="mt-8 w-full bg-violet-600 hover:bg-violet-700 text-white font-bold py-3 px-4 rounded-lg transition-colors" @onclick="ToggleEditMode">
                        Edit Profile
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private MusicGroup group = new MusicGroup();
    private bool isEditing = false;
    private MusicGroup originalGroup = new MusicGroup();

    protected override void OnInitialized()
    {
        group = new MusicGroup
        {
            Id = 1,
            OwnerUserId = 1,
            Slug = "los-rockeros",
            GroupName = "Los Rockeros",
            Description = "Somos una banda de rock alternativo con más de 10 años de experiencia en el escenario. Nuestra música combina sonidos clásicos del rock con elementos modernos, creando una experiencia única para cada audiencia.",
            Biography = "Desde nuestros inicios en los suburbios de la Ciudad de México, hemos llevado nuestro sonido a todos los rincones del país.",
            NumMembers = 4,
            YearsExperience = 10,
            Phone = "55-1234-5678",
            Email = "contacto@losrockeros.com",
            LocationText = "Ciudad de México",
            ServiceRadiusKm = 150,
            Currency = "MXN",
            BasePrice = 800,
            HourlyRate = 200,
            MinimumDurationHours = 3,
            SetupTimeMinutes = 90,
            AverageRating = 4.8m,
            TotalReviews = 24,
            ViewCount = 12500,
            BookingCount = 156,
            IsVerified = true,
            IsFeatured = false,
            IsAcceptingBookings = true,
            Active = true
        };
    }

    private void ToggleEditMode()
    {
        if (!isEditing)
        {
            originalGroup = new MusicGroup
            {
                GroupName = group.GroupName,
                Slug = group.Slug,
                Description = group.Description,
                Biography = group.Biography,
                NumMembers = group.NumMembers,
                YearsExperience = group.YearsExperience,
                Phone = group.Phone,
                Email = group.Email,
                LocationText = group.LocationText,
                ServiceRadiusKm = group.ServiceRadiusKm,
                Currency = group.Currency,
                BasePrice = group.BasePrice,
                HourlyRate = group.HourlyRate,
                MinimumDurationHours = group.MinimumDurationHours,
                SetupTimeMinutes = group.SetupTimeMinutes,
                IsVerified = group.IsVerified,
                IsFeatured = group.IsFeatured,
                IsAcceptingBookings = group.IsAcceptingBookings,
                Active = group.Active
            };
        }
        isEditing = !isEditing;
    }

    private void HandleSave()
    {
        // In a real application, you would save the data to a database here.
        Console.WriteLine("Saving data...");
        isEditing = false;
    }

    private void HandleCancel()
    {
        group = new MusicGroup
        {
            GroupName = originalGroup.GroupName,
            Slug = originalGroup.Slug,
            Description = originalGroup.Description,
            Biography = originalGroup.Biography,
            NumMembers = originalGroup.NumMembers,
            YearsExperience = originalGroup.YearsExperience,
            Phone = originalGroup.Phone,
            Email = originalGroup.Email,
            LocationText = originalGroup.LocationText,
            ServiceRadiusKm = originalGroup.ServiceRadiusKm,
            Currency = originalGroup.Currency,
            BasePrice = originalGroup.BasePrice,
            HourlyRate = originalGroup.HourlyRate,
            MinimumDurationHours = originalGroup.MinimumDurationHours,
            SetupTimeMinutes = originalGroup.SetupTimeMinutes,
            IsVerified = originalGroup.IsVerified,
            IsFeatured = originalGroup.IsFeatured,
            IsAcceptingBookings = originalGroup.IsAcceptingBookings,
            Active = originalGroup.Active
        };
        isEditing = false;
    }
}
