@page "/demo-completa"

<div class="w-full mx-auto p-6 space-y-12">
    
    <section>
        <h2 class="text-2xl font-bold text-accent mb-4">1. Tabla Automática Genérica</h2>
        <GenericTable Items="@MisUsuarios" PageSize="5" />
    </section>
</div>

@code {
    // Modelo de datos
    public class Usuario
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "User";
    }

    private List<Usuario> MisUsuarios = new();

    // Variables para el paginado manual de las Cards
    private int CardPage = 0;
    private int CardPageSize = 3;
    private int CardTotalPages => (int)Math.Ceiling((double)MisUsuarios.Count / CardPageSize);
    
    private IEnumerable<Usuario> UsersForCards => MisUsuarios
        .Skip(CardPage * CardPageSize)
        .Take(CardPageSize);

    protected override void OnInitialized()
    {
        // Generar datos falsos
        for (int i = 1; i <= 25; i++)
        {
            MisUsuarios.Add(new Usuario
            {
                Id = i,
                Nombre = $"Empleado {i}",
                Email = $"emp{i}@empresa.com",
                Role = i % 3 == 0 ? "Admin" : "Staff"
            });
        }
    }
}