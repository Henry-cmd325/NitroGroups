@inject NavigationManager Navigation

<header class="border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 sticky top-0 z-50">
    <div class="container mx-auto px-4 h-16 flex items-center justify-between">

        <div class="flex items-center space-x-2">
            <img src="img/Logo.png" style="width: 30px; margin-top: 5px" />
            <span class="text-xl font-semibold">NitroGroups</span>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="hidden md:flex items-center space-x-6">
                    <span>Panel de Artista</span>
                    <span class="text-muted-foreground">Hola, @context.User.Identity?.Name</span>
                    <button class="bg-primary hover:bg-primary/90 h-8 gap-1.5 px-3 has-[>svg]:px-2.5 text-white rounded" @onclick="BeginLogOut">
                        Cerrar Sesión
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <nav class="hidden md:flex items-center space-x-6 h-full">
                    @* <a href="#artistas" class="text-muted-foreground hover:text-foreground transition-colors">Artistas</a>
                    <a href="#clientes" class="text-muted-foreground hover:text-foreground transition-colors">Clientes</a>
                    <a href="#funcionalidades" class="text-muted-foreground hover:text-foreground transition-colors">Funcionalidades</a> *@
                </nav>
                <div class="hidden md:flex items-center space-x-3">
                    <a class="flex items-center cursor-pointer rounded hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 h-8 gap-1.5 px-3 has-[>svg]:px-2.5" href="authentication/login">Iniciar Sesión</a>
                    <a @onclick="NavigateToRegister" class="flex items-center bg-primary cursor-pointer hover:bg-primary/90 h-8 gap-1.5 px-3 has-[>svg]:px-2.5 text-white rounded">Registrarse</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <button class="md:hidden p-2" @onclick="ToggleMenu">
            @if (isMenuOpen)
            {
                <span class="text-2xl">✕</span>
            }
            else
            {
                <span class="text-2xl">☰</span>
            }
        </button>

    </div>

    <div class="@(isMenuOpen ? "block" : "hidden") md:hidden border-t py-2">
        <AuthorizeView>
            <Authorizing></Authorizing>
            <Authorized>
                <div class="flex flex-col space-y-2 px-4">
                    <span class="text-lg font-medium py-2">Panel de Artista</span>
                    <span class="text-muted-foreground">Hola, @context.User.Identity?.Name</span>
                    <button class="bg-primary hover:bg-primary/90 py-2 text-white rounded" @onclick="BeginLogOut">
                        Cerrar Sesión
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="flex flex-col space-y-1 px-4">
                    <a href="#artistas" @onclick="ToggleMenu" class="block py-2 px-2 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">Artistas</a>
                    <a href="#clientes" @onclick="ToggleMenu" class="block py-2 px-2 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">Clientes</a>
                    <a href="#funcionalidades" @onclick="ToggleMenu" class="block py-2 px-2 text-muted-foreground hover:text-foreground hover:bg-accent transition-colors">Funcionalidades</a>

                    <div class="pt-4 flex flex-col space-y-2">
                        <a class="py-2 text-center border rounded hover:bg-accent" href="authentication/login">Iniciar Sesión</a>
                        <a @onclick="NavigateToRegister" class="bg-primary hover:bg-primary/90 py-2 text-center text-white rounded">Registrarse</a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>

</header>

@code {
    private bool isMenuOpen = false;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void BeginLogOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }

    private void NavigateToRegister()
    {
        // 1. Define la URL a la que el usuario debe volver después del registro exitoso
        var returnUrl = "/"; // Por ejemplo, la página de inicio o un panel

        var url = "authentication/login";
        url = QueryHelpers.AddQueryString(url, "returnUrl", returnUrl);
        url = QueryHelpers.AddQueryString(url, "screen_hint", "signup");

        // 3. Llama al método NavigateTo, especificando el componente de login de Blazor
        Navigation.NavigateToLogin(url);
    }
}