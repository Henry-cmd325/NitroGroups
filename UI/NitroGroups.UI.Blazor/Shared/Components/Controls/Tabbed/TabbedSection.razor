@* // ===================================================================================
// TabbedSection.razor: Componente de navegación por pestañas genérico y reutilizable.
// Acepta componentes <TabItem> como hijos para definir sus secciones.
// La directiva CascadingValue hace que 'this' esté disponible para los hijos TabItem.
// =================================================================================== *@

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

<div class="mx-auto mt-5 px-3">

    <nav class="flex justify-around mb-2 overflow-x-auto bg-muted text-muted-foreground p-[3px] rounded-2xl">
        @foreach (var tab in Tabs)
        {
            var isSelected = tab.Key == SelectedTabKey;
            var tabClass = isSelected
            ? "py-[2px] px-4 bg-card text-white w-full font-semibold transition-colors duration-200 cursor-pointer whitespace-nowrap rounded-2xl"
            : "py-[2px] px-4 text-white w-full hover:bg-card/50 transition-colors duration-200 cursor-pointer whitespace-nowrap rounded-2xl";

            <button class="@tabClass" @onclick="() => SelectTab(tab.Key)">
                @tab.Title
            </button>
        }
    </nav>

    <div class="p-2 rounded-xl shadow-lg">
        @if (ActiveTab is not null)
        {
            @ActiveTab.ChildContent
        }
        else
        {
            <p class="text-white">Selecciona una sección para ver el contenido.</p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Contiene los componentes <TabItem> que definen las pestañas.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Lista interna de todos los <TabItem> registrados como hijos.
    /// </summary>
    private List<TabItem> Tabs { get; set; } = new List<TabItem>();

    /// <summary>
    /// Clave de la pestaña actualmente seleccionada.
    /// </summary>
    private string SelectedTabKey { get; set; } = string.Empty;

    /// <summary>
    /// Devuelve el componente <TabItem> que está activo actualmente.
    /// </summary>
    private TabItem? ActiveTab => Tabs.FirstOrDefault(t => t.Key == SelectedTabKey);

    /// <summary>
    /// Permite a los <TabItem> hijos registrarse en la lista.
    /// </summary>
    /// <param name="tab">Instancia del componente TabItem.</param>
    public void AddTab(TabItem tab)
    {
        Tabs.Add(tab);
        // Selecciona la primera pestaña automáticamente si es la primera en registrarse
        if (Tabs.Count == 1)
        {
            SelectedTabKey = tab.Key;
        }
        // Fuerza el re-renderizado para mostrar el contenido de la primera pestaña
        StateHasChanged();
    }

    /// <summary>
    /// Función para cambiar la pestaña activa.
    /// </summary>
    /// <param name="tabKey">La clave (string) de la pestaña a seleccionar.</param>
    private void SelectTab(string tabKey)
    {
        SelectedTabKey = tabKey;
    }
}