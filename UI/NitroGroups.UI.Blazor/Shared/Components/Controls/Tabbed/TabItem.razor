@using Microsoft.AspNetCore.Components

@* // ===================================================================================
// TabItem.razor: Define una pestaña individual. Este componente se usa dentro de
// TabbedSection para pasar el título y el contenido.
// =================================================================================== *@

@code {
    // Título que aparecerá en la navegación.
    [Parameter]
    public string Title { get; set; } = string.Empty;

    // Clave única para identificar la pestaña (necesaria para el estado interno).
    [Parameter]
    public string Key { get; set; } = Guid.NewGuid().ToString("N");

    // Contenido RenderFragment que se mostrará cuando esta pestaña esté activa.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Referencia al componente padre (TabbedSection) para registrar esta pestaña.
    [CascadingParameter]
    public TabbedSection? Parent { get; set; }

    protected override void OnInitialized()
    {
        // Al inicializarse, registra esta pestaña en el componente padre.
        if (Parent is null)
        {
            throw new InvalidOperationException($"{nameof(TabItem)} debe usarse dentro de un componente {nameof(TabbedSection)}.");
        }

        Parent.AddTab(this);
    }
}