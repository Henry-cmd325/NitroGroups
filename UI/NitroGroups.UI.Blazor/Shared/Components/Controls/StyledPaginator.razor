@if (TotalPages > 1)
{
    <div class="flex items-center justify-between px-4 py-3 sm:px-6 mt-4">
        <div>
            <p class="text-sm text-card-foreground">
                Página <span class="font-medium">@(CurrentPage + 1)</span> de <span class="font-medium">@TotalPages</span>
            </p>
        </div>
        <div class="flex flex-1 justify-between pl-2">
            <button @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(!CanGoBack)"
                    class="relative cursor-pointer inline-flex items-center rounded-md border border-primary px-4 py-2 text-sm font-medium text-white hover:bg-card disabled:opacity-50 rounded">
                Anterior
            </button>
            <button @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(!CanGoForward)"
                    class="relative cursor-pointer ml-3 inline-flex items-center rounded-md border border-primary px-4 py-2 text-sm font-medium text-white hover:bg-card disabled:opacity-50 rounded">
                Siguiente
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool CanGoBack => CurrentPage > 0;
    private bool CanGoForward => CurrentPage < TotalPages - 1;

    private async Task ChangePage(int newPage)
    {
        if (newPage >= 0 && newPage < TotalPages)
        {
            await OnPageChanged.InvokeAsync(newPage);
        }
    }
}