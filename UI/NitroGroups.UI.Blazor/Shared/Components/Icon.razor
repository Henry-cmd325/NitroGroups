@*
Este componente acepta el contenido SVG como un RenderFragment
y cualquier otra clase CSS a través de 'AdditionalAttributes'.
*@
<svg 
    @attributes="AdditionalAttributes"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
>
    @ChildContent
</svg>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}