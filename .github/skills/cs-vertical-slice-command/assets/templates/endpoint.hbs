using Carter;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using NitroGroups.Shared.Contracts.{{moduleName}};
using NitroGroups.Shared.EndpointMapping;
using Cortex.Mediator;
using NitroGroups.Core.{{moduleName}}.Application.UseCases.{{actionName}};

namespace NitroGroups.Core.{{moduleName}}.Infrastructure.Endpoints;

public class {{actionName}}Endpoint : IEndpoint
{
    public void MapEndpoint(IEndpointRouteBuilder app)
    {
        app.MapPost("/api/{{moduleName | lower}}/{{actionName | lower}}", async ([FromBody] {{actionName}}Request request, IMediator mediator, CancellationToken cancellationToken) =>
        {
            var command = new {{actionName}}Command({{propertiesDefinition}});
            var result = await mediator.SendCommandAsync(command, cancellationToken);

            return result.IsSuccess
                ? Results.Created($"/api/{{moduleName | lower}}/{result.Value.Success}", result.Value) // [GENERATED_INSTRUCTION]: Adjust URI for Created status to point to the newly created resource.
                : Results.BadRequest(result.Error);
        })
        .WithName("{{actionName}}{{moduleName}}")
        .Produces<{{actionName}}Response>(StatusCodes.Status201Created)
        .ProducesValidationProblem(StatusCodes.Status400BadRequest)
        .WithOpenApi();
    }
}
